# 必須
DISCORD_TOKEN=ここにBotのトークン
GUILD_ID=ここにサーバーID

# 保存先(Railway では /data に Volume をマウントして DATA_DIR=/data)
DATA_DIR=./data
POLL_MINUTES=10
POST_ON_FIRST_RUN=0

# 投稿間隔(分)
IMAGE_INTERVAL_MINUTES=60
HEAVY_RAIN_INTERVAL=10
TYPHOON_INTERVAL=30
HEAVY_RAIN_MM=30
WATCH_BBOX=128.5,30.0,135.5,35.8

# ウィンドプロファイラ(自動投稿する地点。空欄なら自動投稿しない)
WPR_STATIONS=高知,清水,大分
WPR_INTERVAL_MINUTES=60
WPR_HOURS=6

# ひまわりの観測データから作る画像(i4, w2, w3, s1, s2 から選ぶ。空欄で停止)
HSD_IMAGES=i4,w2,w3,s1,s2
HSD_MIN_INTERVAL=30

# アメダス天気図を投稿する時刻(日本時間)
AMEDAS_MAP_HOURS=0,3,6,9,12,15,18,21

# 沿岸波浪実況図:画像が自動で見つからないときだけ、画像のURLを書く
WAVE_IMAGE_URL=

# SSI分布(MSMの初期時刻UTCと、図にする予報時間)
SSI_ENABLED=1
SSI_CYCLES=0,6,12,18
SSI_HOURS=0,6,12

# 季節予報の地方(予報区コード:名前)
SEASON_AREAS=010800:四国地方,010900:九州北部地方
